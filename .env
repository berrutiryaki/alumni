# ---------------------------------------------------------------
# Alumni Platform — Environment Variables
# ---------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production

# Data persistence directory (used by app/storage.py)
DATA_DIR=./data

# PostgreSQL (reserved for future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alumni_db
DB_USER=alumni_user
DB_PASSWORD=
DATABASE_URL=
